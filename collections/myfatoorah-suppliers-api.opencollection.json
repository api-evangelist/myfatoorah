{
  "opencollection": "1.0.0",
  "info": {
    "name": "MyFatoorah Invoicing Suppliers API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Suppliers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List marketplace suppliers",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apitest.myfatoorah.com/v2/GetSuppliers"
          },
          "docs": "Returns the suppliers configured on the account for split settlement. MODELED representative shape."
        }
      ]
    }
  ],
  "bundled": true
}